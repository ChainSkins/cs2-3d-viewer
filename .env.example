# Copy to .env.local (development) or .env.production (build) and adjust.

# Where the game assets (models, textures, maps, videos) are served from. Must end with "/".
# Unset: '/assets/' of this site (public/assets/ in development).
VITE_ASSET_BASE=https://3dassets.example.com/

# Public origin of the viewer, for the links it generates (share links, embed). Unset: the page's own origin.
VITE_WEB_DOMAIN=https://3d.example.com
